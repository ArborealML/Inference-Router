root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# ── .NET analyzers ─────────────────────────────────────────────────
dotnet_diagnostic.CA2000.severity = warning      # dispose objects
dotnet_diagnostic.CA2016.severity = warning      # forward CancellationToken
dotnet_diagnostic.CA1848.severity = warning      # use generated LoggerMessage delegates
dotnet_diagnostic.CA1859.severity = suggestion   # use concrete types
dotnet_diagnostic.CA2007.severity = none         # ConfigureAwait noise (we ConfigureAwait(false) by convention, not force)
dotnet_diagnostic.CA1031.severity = none         # catch-and-log at boundaries is intentional here
dotnet_diagnostic.RS0030.severity = error        # banned APIs (see BannedSymbols.txt)

# ── Meziantou.Analyzer ─────────────────────────────────────────────
dotnet_diagnostic.MA0001.severity = warning      # StringComparison missing
dotnet_diagnostic.MA0002.severity = warning      # use Ordinal / OrdinalIgnoreCase
dotnet_diagnostic.MA0004.severity = none         # ConfigureAwait noise
dotnet_diagnostic.MA0122.severity = none         # object/method visibility (composition root internals)

# ── IDisposableAnalyzers ───────────────────────────────────────────
dotnet_diagnostic.IDISP001.severity = warning    # dispose created disposable
dotnet_diagnostic.IDISP004.severity = warning    # don't stop referencing disposable field

# ── AsyncFixer ─────────────────────────────────────────────────────
dotnet_diagnostic.AsyncFixer02.severity = warning   # long-running/blocking code in async

# ── xUnit ──────────────────────────────────────────────────────────
dotnet_diagnostic.xUnit2021.severity = error     # wrong equality assertion types

# ── BannedApiAnalyzers ─────────────────────────────────────────────
dotnet_diagnostic.RS0016.severity = none

# ── tuned after first integration pass (documented in SPEC §9) ───────────────
# Style-only rules that conflict with deliberate repo conventions:
dotnet_diagnostic.MA0048.severity = none       # we group cohesive small types per file by design
dotnet_diagnostic.CA1707.severity = none       # Method_Scenario_Expectation test naming is deliberate
dotnet_diagnostic.MA0006.severity = none       # string == is always ordinal; explicit comparisons used where culture matters
dotnet_diagnostic.MA0008.severity = none       # StructLayout not wanted on tiny value types
dotnet_diagnostic.MA0046.severity = suggestion # event sender convention (EventHandler<T> adopted where it applies)
dotnet_diagnostic.MA0016.severity = suggestion # DTOs need concrete List/Dictionary for source-gen binding
dotnet_diagnostic.MA0051.severity = suggestion # dispatch loop is intentionally one cohesive method
dotnet_diagnostic.MA0158.severity = suggestion # System.Threading.Lock migration is a follow-up
dotnet_diagnostic.AsyncFixer01.severity = suggestion
dotnet_diagnostic.IDISP004.severity = suggestion # JsonElement enumerator false positives dominate; CA2000/IDISP001 stay errors
dotnet_diagnostic.CA1711.severity = suggestion   # ModelQueue/EventRing are domain vocabulary, not suffix smells
