# Add to the profile with: air completion powershell | Out-String | Invoke-Expression
Register-ArgumentCompleter -Native -CommandName air, air.exe -ScriptBlock {
    param($wordToComplete, $commandAst, $cursorPosition)
    $prior = [System.Collections.Generic.List[string]]::new()
    $current = $wordToComplete
    foreach ($part in @($commandAst.CommandElements | Select-Object -Skip 1)) {
        if ($part.Extent.StartOffset -ge $cursorPosition) { break }
        if ($part.Extent.EndOffset -ge $cursorPosition) {
            $current = $part.Extent.Text.Substring(0, $cursorPosition - $part.Extent.StartOffset)
            if ($cursorPosition -eq $part.Extent.EndOffset -and $part -is [System.Management.Automation.Language.StringConstantExpressionAst]) {
                $current = $part.Value
            } elseif ($current.Length -gt 0 -and $current[0] -in "'", '"') {
                $q = $current[0]
                $current = $current.Substring(1)
                if ($current.EndsWith([string]$q)) { $current = $current.Substring(0, $current.Length - 1) }
                if ($q -eq "'") { $current = $current.Replace("''", "'") }
            }
            break
        }
        if ($part -is [System.Management.Automation.Language.StringConstantExpressionAst]) { $prior.Add($part.Value) }
        else { $prior.Add($part.Extent.Text) }
    }
    $arguments = $prior.ToArray()
    foreach ($candidate in @(& air completion candidates "--current=$current" @arguments)) {
        if (-not $candidate) { continue }
        $insert = $candidate
        if ($arguments.Count -gt 0 -and $arguments[-1] -in '-c', '--config', '--baseline', '--candidate' -and
            ($insert.StartsWith('~/') -or $insert.StartsWith('~\'))) {
            # Native programs receive a literal tilde from PowerShell, even in an unquoted word.
            $insert = [System.IO.Path]::Combine($HOME, $insert.Substring(2))
        }
        if ($insert -notmatch '^[a-zA-Z0-9_./:-]+$') { $insert = "'" + [System.Management.Automation.Language.CodeGeneration]::EscapeSingleQuotedStringContent($insert) + "'" }
        [System.Management.Automation.CompletionResult]::new($insert, $candidate, 'ParameterValue', $candidate)
    }
}
