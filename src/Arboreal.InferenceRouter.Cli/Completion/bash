# Load with: source <(air completion bash)
_air_complete() {
    local input=${COMP_LINE:0:COMP_POINT} word= quote= char next suffix= i
    local -a words=()
    # Decode shell quoting without evaluating the command line. Keep empty quoted words.
    local started=0
    for ((i=0; i<${#input}; i++)); do
        char=${input:i:1}
        case $quote in
            "'") if [[ $char == "'" ]]; then quote=; else word+=$char; fi; continue ;;
            '"') case $char in
                    '"') quote= ;;
                    \\) next=${input:i+1:1}; case $next in '$'|'"'|'\'|'`') word+=$next; ((i++));; *) word+=$char;; esac ;;
                    *) word+=$char ;;
                 esac; continue ;;
        esac
        case $char in
            ' '|$'\t'|$'\n') if ((started)); then words+=("$word"); fi; word=; suffix=; started=0 ;;
            ';'|'|'|'&') words=(); word=; suffix=; started=0 ;;
            "'"|'"') quote=$char; started=1 ;;
            \\) ((i++)); word+=${input:i:1}; started=1 ;;
            *) word+=$char; started=1; if [[ $COMP_WORDBREAKS == *"$char"* ]]; then suffix=$word; fi ;;
        esac
    done
    COMPREPLY=()
    (("${#words[@]}")) || return 0
    local item literal
    while IFS= read -r item; do
        literal=${item#"$suffix"}
        case $quote in
            "'") literal=${literal//\'/\'\\\'\'} ;;
            '"') literal=${literal//\\/\\\\}; literal=${literal//\$/\\\$}
                 literal=${literal//\`/\\\`}; literal=${literal//\"/\\\"} ;;
            *) case ${words[${#words[@]}-1]} in
                   -c|--config|--baseline|--candidate)
                       if [[ $literal == '~/'* ]]; then
                           if [[ $literal == '~/' ]]; then COMPREPLY+=('~/'); continue; fi
                           printf -v literal '%q' "${literal:2}"; literal="~/${literal}"
                           COMPREPLY+=("$literal"); continue
                       fi ;;
               esac
               printf -v literal '%q' "$literal" ;;
        esac
        COMPREPLY+=("$literal")
    done < <(command air completion candidates "--current=$word" "${words[@]:1}")
}
complete -o noquote -F _air_complete air 2>/dev/null || complete -F _air_complete air
